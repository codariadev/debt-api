generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DebtStatus {
  PENDING
  PAID
  OVERDUE
}

model Debt {
  id          String     @id @default(uuid())
  description String
  amount      Decimal    @db.Decimal(10, 2)
  dueDate     DateTime
  status      DebtStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("debts")
}